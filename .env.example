# Copy this file to .env and replace the value with your Kindwise crop.health key.
CROP_HEALTH_API_KEY=your_crop_health_api_key

# iSDA Virtual Agronomist authenticates with registered credentials, then issues a JWT.
ISDA_USERNAME=your_registered_email
ISDA_PASSWORD=your_registered_password

# OpenWeather API key (standard free API access).
OPENWEATHER_API_KEY=your_openweathermap_api_key

# Anthropic Claude API key for field-level risk analysis.
ANTHROPIC_API_KEY=your_anthropic_api_key
