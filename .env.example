# Copia in .env.local (mai committare i valori veri). Vedi spec.md §13 e docs/database.md §8.

# memory = data/seed.json (fase 1, default) · db = Azure PostgreSQL (fase 2)
DATA_SOURCE=memory

# "Adesso" della demo. Se manca si usa demoNow di data/seed.json.
DEMO_NOW=2027-03-01T05:00:00Z

# ─── Servizi esterni: senza chiave l'app usa le risposte/dati demo ───────────

# Claude: assistente della dashboard (lib/assistant/claude.ts) e diagnosi da foto.
# ANTHROPIC_API_KEY=

# Kindwise crop.health: riconoscimento malattie da foto della foglia.
# CROP_HEALTH_API_KEY=

# OpenWeather (API gratuita): meteo reale per zona.
# OPENWEATHER_API_KEY=

# iSDA Virtual Agronomist: piano di concimazione (facoltativo).
# ISDA_USERNAME=
# ISDA_PASSWORD=

# Solo con DATA_SOURCE=db (fase 2)
# DATABASE_URL=postgresql://felix_app:<pwd>@felix-field-db.postgres.database.azure.com:5432/felix_dev?sslmode=require&connection_limit=1&pool_timeout=20
# DIRECT_URL=postgresql://felix_migrator:<pwd>@felix-field-db.postgres.database.azure.com:5432/felix_dev?sslmode=require
# SHADOW_DATABASE_URL=postgresql://felix_migrator:<pwd>@felix-field-db.postgres.database.azure.com:5432/felix_shadow?sslmode=require
