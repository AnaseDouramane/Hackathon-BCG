# Copia in .env.local (mai committare i valori veri). Vedi spec.md §13 e docs/database.md §8.

# memory = data/seed.json (fase 1, default) · db = Azure PostgreSQL (fase 2)
DATA_SOURCE=memory

# "Adesso" della demo. Se manca si usa demoNow di data/seed.json.
DEMO_NOW=2027-03-01T05:00:00Z

# ─── Servizi esterni: senza chiave l'app usa le risposte/dati demo ───────────
# La pipeline di analisi (lib/pipeline, bottone "Update" in dashboard) li chiama tutti;
# una fonte senza chiave viene saltata e le altre vanno avanti.

# Claude: assistente della dashboard e classificazione dei rischi per campo (port di risk.py).
# ANTHROPIC_API_KEY=

# Kindwise crop.health: malattie dalle foto caricate nei campi (consuma crediti: solo foto nuove).
# CROP_HEALTH_API_KEY=

# OpenWeather (API gratuita): meteo reale per le 8 stazioni di zona.
# OPENWEATHER_API_KEY=

# Vercel Blob (store "public"): snapshot dell'analisi e foto. Senza token, in locale si usa .data/
# BLOB_READ_WRITE_TOKEN=

# iSDA Virtual Agronomist: piano di concimazione (facoltativo).
# ISDA_USERNAME=
# ISDA_PASSWORD=

# Solo con DATA_SOURCE=db (fase 2)
# DATABASE_URL=postgresql://felix_app:<pwd>@felix-field-db.postgres.database.azure.com:5432/felix_dev?sslmode=require&connection_limit=1&pool_timeout=20
# DIRECT_URL=postgresql://felix_migrator:<pwd>@felix-field-db.postgres.database.azure.com:5432/felix_dev?sslmode=require
# SHADOW_DATABASE_URL=postgresql://felix_migrator:<pwd>@felix-field-db.postgres.database.azure.com:5432/felix_shadow?sslmode=require
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=bcg.hackathon.team3@gmail.com
SMTP_PASS=la_password
EMAIL_FROM=bcg.hackathon.team3@gmail.com
EMAIL_TRIGGER_SECRET=una_stringa_lunga_a_caso

# Indirizzi che ricevono "Dear farmer, your field has an issue" (separati da virgola)
ALERT_EMAIL_TO=

# Login (lib/auth/session.ts): utente demo e segreto per firmare il cookie (stringa lunga a caso)
AUTH_USERNAME=
AUTH_PASSWORD=
SESSION_SECRET=
